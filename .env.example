# 토스증권 Open API — .env 로 복사해서 값을 채우세요 (.env 는 gitignore 처리됨)
#   발급: 토스증권 WTS 로그인 > 설정 > Open API > client_id / client_secret
#   허용 IP: 같은 화면 하단 '허용 IP 관리'에 이 PC 의 공인 IP 를 등록 (미등록 IP 는 403)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 선택
# TOSS_PROXY_PORT=8778
# TOSS_ALLOWED_ORIGINS=https://nowjay.github.io   # localhost 외의 페이지에서 프록시를 쓰려면 (콤마 구분)
