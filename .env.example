# 토스증권 Open API — .env 로 복사해서 값을 채우세요 (.env 는 gitignore 처리됨)
#   발급: 토스증권 WTS 로그인 > 설정 > Open API > client_id / client_secret
#   허용 IP: 같은 화면 하단 '허용 IP 관리'에 이 PC 의 공인 IP 를 등록 (미등록 IP 는 403)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 선택
# TOSS_PROXY_PORT=8778
# 원격 접속(다른 기기) — 클라우드 서버에서는 tools/server/setup.sh 가 알아서 채웁니다
# TOSS_ALLOWED_ORIGINS=https://nowjay.github.io   # localhost 외의 페이지에서 프록시를 쓰려면 (콤마 구분)
# TOSS_PROXY_KEY=                                 # 위를 쓰면 필수 — 브라우저 설정의 '프록시 접속 키'

# 공공데이터포털 '금융위원회_주식시세정보' 일반 인증키(Decoding) — python3 tools/build_krx.py 로컬 실행용
#   배포는 GitHub Secret DATA_GO_KR_KEY 를 씁니다 (gh secret set DATA_GO_KR_KEY)
# DATA_GO_KR_KEY=
